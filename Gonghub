local UI = require(game.ReplicatedStorage.NexusUI)

local Window = UI:CreateWindow({
    Title = "Nexus UI",
    Description = "Modern Interface Framework",
    Size = UDim2.fromOffset(600, 420),
    Theme = "Dark",
    Resizable = true,
    Draggable = true
})

local Tab = Window:AddTab({
    Name = "Home",
    Icon = "house"
})

local Section = Tab:AddSection("General")

Section:AddButton({
    Name = "Click Me",
    Description = "An example button",
    Callback = function()
        print("Button clicked!")
    end
})

Section:AddToggle({
    Name = "Enable Feature",
    Default = false,
    Callback = function(value)
        print("Enabled:", value)
    end
})

Section:AddSlider({
    Name = "Volume",
    Min = 0,
    Max = 100,
    Default = 50,
    Callback = function(value)
        print("Volume:", value)
    end
})

Section:AddInput({
    Name = "Username",
    Placeholder = "Enter username...",
    Callback = function(value)
        print(value)
    end
})

Section:AddDropdown({
    Name = "Select Option",
    Options = {"Option A", "Option B", "Option C"},
    Default = "Option A",
    Searchable = true,
    Callback = function(value)
        print(value)
    end
})

UI:Notify({
    Title = "Nexus UI",
    Content = "Interface initialized!",
    Duration = 3
})
